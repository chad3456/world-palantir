# ─────────────────────────────────────────────────────────────────────────────
# WORLD PALANTIR — environment configuration
# Copy this file to `.env` and fill in keys to unlock key-gated layers.
# ALL layers degrade gracefully: without a key the layer shows an honest empty
# state — it NEVER displays fabricated/simulated data.
# ─────────────────────────────────────────────────────────────────────────────

# AIS real-time ship tracking (maritime / oil tankers / ship traffic).
# Free key from https://aisstream.io  (WebSocket stream).
VITE_AISSTREAM_KEY=

# OpenSky Network (flights). Anonymous works but is heavily rate-limited.
# Free account raises limits: https://opensky-network.org
VITE_OPENSKY_USER=
VITE_OPENSKY_PASS=

# Cloudflare Radar (internet outages / disruptions).
# Free token from https://dash.cloudflare.com (Radar read scope).
VITE_CLOUDFLARE_RADAR_TOKEN=

# abuse.ch (cyber threats — ThreatFox / URLhaus). Free Auth-Key required since 2024.
# https://auth.abuse.ch
VITE_ABUSECH_KEY=

# ACLED (armed conflict events) — optional richer conflict data.
# Free academic/research key: https://acleddata.com
VITE_ACLED_KEY=
VITE_ACLED_EMAIL=
